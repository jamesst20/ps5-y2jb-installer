{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Y2JB Installer",
  "version": "1.1.0",
  "identifier": "dev.y2jb.installer",
  "build": {
    "beforeBuildCommand": "node ../scripts/prepare-build.mjs",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Y2JB Installer",
        "width": 960,
        "height": 820,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://*:47291; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
